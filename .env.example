# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `npx supabase status -o env` after `npx supabase start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never in client code
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # tests/scripts only
APP_BASE_URL=http://127.0.0.1:3000
APP_ENV=development               # development | preview | production
DEPLOY_MODE=cloud                 # cloud | lan
AUDIT_IP_HASH_SALT=               # random 32+ bytes: openssl rand -base64 32
TOKEN_HASH_PEPPER=                # random 32+ bytes (api_tokens hashing; used from Phase 3)
TOKEN_ENC_KEY=                    # 32-byte base64 (OAuth token encryption; reserved for later phases)
MAILER_DRIVER=local               # local | resend  (local for Phases 0-2)
FORMS_RATE_LIMIT_PER_MIN=10
SEED_OWNER_EMAIL=                 # your login email for the local seed (npm run seed:emails)
SEED_PARTNER_EMAIL=               # partner's login email for the local seed

# Reserved for later phases:
# AI_GATEWAY_API_KEY=
# OLLAMA_BASE_URL=
# WORKER_CONCURRENCY=1
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CRON_SECRET=
# SENTRY_DSN=
